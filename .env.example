# ------------------------------------------------------------------
# TaskFlow — приклад змінних оточення.
# Скопіюйте у `.env` (`cp .env.example .env`) перед `docker-compose up`.
# ------------------------------------------------------------------

# ---- Загальне ----
NODE_ENV=development

# ---- PostgreSQL (використовується сервісом postgres у docker-compose) ----
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_secret
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# Рядок підключення для Prisma. У docker-compose host = ім'я сервісу `postgres`.
# Для локального запуску без Docker замініть `postgres` на `localhost`.
DATABASE_URL=postgresql://taskflow:taskflow_secret@postgres:5432/taskflow?schema=public

# ---- Backend (NestJS) ----
BACKEND_PORT=8080
# Дозволений origin фронтенду для CORS.
CORS_ORIGIN=http://localhost:3000
# Публічна адреса фронтенду (для посилань у email-запрошеннях).
FRONTEND_URL=http://localhost:3000

# ---- JWT ----
# Токени видаються у httpOnly-cookie (недоступні для JavaScript → захист від XSS).
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUNDS=10

# Час життя auth-cookie у мілісекундах (за замовчуванням 15 хв / 7 днів).
ACCESS_COOKIE_MAX_AGE=900000
REFRESH_COOKIE_MAX_AGE=604800000

# ---- Rate limiting (throttler) ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Окремий, суворіший ліміт для /auth/login (спроб за хвилину).
AUTH_THROTTLE_LIMIT=5

# ---- Redis (черга email-запрошень, BullMQ) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- SMTP (Mailhog у dev) ----
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM="TaskFlow <no-reply@taskflow.local>"

# ---- Frontend (build-time, Vite) ----
# У docker-compose фронтенд ходить у бекенд через nginx-проксі, тож лишаємо відносні шляхи.
VITE_API_URL=/api
VITE_WS_URL=/
